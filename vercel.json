{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "ng build",
  "outputDirectory": "dist/splash-hunt/browser",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "crons": [{ "path": "/api/keep-alive", "schedule": "0 12 * * *" }]
}
